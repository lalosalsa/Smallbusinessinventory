# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- Database -------------------------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string ->
# "Transaction pooler" (or "Session pooler"). Swap in your database password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Sign-in --------------------------------------------------------------
# Set both to use Supabase Auth. Leave them out and the app keeps its own
# email/password sign-in in the local_users table instead.
# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon public key>

# --- Optional -------------------------------------------------------------
# PORT=3000
# AUTH_SECRET=<random string; only used by local sign-in, generated if unset>
# SKIP_MIGRATE=1        # do not apply sql/schema.sql at boot
# PGSSL=disable         # for a plain local Postgres
