# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- Database -------------------------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string ->
# "Transaction pooler" (or "Session pooler"). Swap in your database password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Sign-in --------------------------------------------------------------
# Left as it is, the app handles sign-in itself: a new person picks a password
# and is straight in. No confirmation email, no verification code, no magic
# link. This is the default and needs nothing configured.
#
# To use Supabase Auth instead (password resets and email handled for you),
# set all three of these. Before you do, turn OFF
#   Authentication -> Sign In / Providers -> Email -> "Confirm email"
# in the Supabase dashboard, or new people will be made to click an emailed
# link before they can get in.
# AUTH_MODE=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon public key>

# --- Optional -------------------------------------------------------------
# PORT=3000
# AUTH_SECRET=<random string; signs sign-in tokens. Generated and saved to a file
#              if unset, which suits a laptop or a single server. On Vercel or any
#              serverless host it MUST be set: "npm run secret" prints one>
# SKIP_MIGRATE=1        # do not apply sql/schema.sql at boot
# PGSSL=disable         # for a plain local Postgres
